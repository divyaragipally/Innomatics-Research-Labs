def mimic_title(s):
    result = ""
    make_upper=True
    for ch in s:
        if make_upper and 'a'<=ch<='z':
            result+=chr(ord(ch)-32)
        elif make_upper and 'A'<=ch<='Z':
            result+=chr(ord(ch)+32)
        else:
            result+=ch
        if ch==" ":
            make_upper=True
        else:
            make_upper=False
    return result
print(mimic_title("she sells sea shells on the sea shore"))
