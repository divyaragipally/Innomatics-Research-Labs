def mimic_swap(s):
    result=""
    if len(s)==0:
        return s
    for i in s:
        if 'a'<=i<='z':
            result+=chr(ord(i)-32)
        elif 'A'<=i<='Z':
            result+=chr(ord(i)+32)
        else:
            result+=i
    return result
my_str="shE seLLs Sea SheLlS oN The ShoRe"
mimic_swap(my_str)
